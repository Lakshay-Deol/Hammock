# Hammock Environment Variables

# Hard invariant: HAMMOCK_DRY_RUN defaults to 1.
# Setting to 0 requires deliberate configuration change AND valid HAMMOCK_SANDBOX_REPO.
HAMMOCK_DRY_RUN=1

# Hard invariant: assertWritable(repo) throws unless repo === HAMMOCK_SANDBOX_REPO.
HAMMOCK_SANDBOX_REPO=your-org/your-sandbox-repo

# GitHub token (for real runs). Never commit real tokens!
GITHUB_TOKEN=

# Ollama local endpoints
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Replay mode for deterministic demo/tests (no network, uses fixtures)
HAMMOCK_REPLAY=0

# Database path
HAMMOCK_DB_PATH=./hammock.db
